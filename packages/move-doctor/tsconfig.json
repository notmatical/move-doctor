{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "strictNullChecks": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "dist", "node_modules"]
}
